{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2023"],
        "types": ["node"],
        "rewriteRelativeImportExtensions": true,
